<?xml version="1.0" encoding="UTF-8" ?>
<component type="desktop-application">
  <id>dev.heppen.webapps</id>
  <developer id="dev.sala-do-futuro">
    <name>Sala do Futuro</name>
  </developer>
  <url type="homepage">https://saladofuturo.educacao.sp.gov.br</url>
  <url type="vcs-browser">https://github.com/felix-the-cat177/sala-do-futuro-for-pop-os-cosmic-webapp</url>
  <url type="bugtracker">https://github.com/felix-the-cat177/sala-do-futuro-for-pop-os-cosmic-webapp/issues</url>
  <url type="contribute">https://github.com/felix-the-cat177/sala-do-futuro-for-pop-os-cosmic-webapp</url>
  <name>Sala do Futuro</name>
  <summary>Aplicativo web para a Sala do Futuro - Pop!_OS COSMIC</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>Aplicativo web educacional para a Sala do Futuro, integrado com o ambiente COSMIC. Navegador Chromium com aceleracao de hardware e API Vulkan para melhor performance. Inclui notificacoes de tarefas, redacoes e provas.</p>
    <ul>
      <li>Navegador Chromium com aceleracao de hardware</li>
      <li>Suporte a API Vulkan</li>
      <li>Integracao com COSMIC</li>
      <li>Notificacoes de atividades escolares</li>
      <li>Rapido e facil de usar</li>
    </ul>
  </description>
  <launchable type="desktop-id">dev.heppen.webapps.desktop</launchable>
  <content_rating type="oars-1.1" />
  <categories>
    <category>Education</category>
    <category>Utility</category>
  </categories>
  <provides>
    <id>com.system76.CosmicApplication</id>
  </provides>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/cosmic-utils/web-apps/refs/tags/3.0.0/resources/screenshots/window.png</image>
      <caption>Sala do Futuro em execucao</caption>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#94ebeb</color>
    <color type="primary" scheme_preference="dark">#578383</color>
  </branding>
  <requires>
    <display_length compare="ge">640</display_length>
    <internet>always</internet>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <releases>
    <release version="1.0.0" date="2026-06-19">
